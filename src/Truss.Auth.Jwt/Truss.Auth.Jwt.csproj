<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Truss.Auth.Jwt</PackageId>
    <Description>JWT authentication for Truss: PBKDF2 password hashing, access and refresh token issuing, and JwtBearer wiring. The user model stays in your domain.</Description>
    <PackageTags>Auth;Authentication;JWT;Security;AspNetCore</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Truss.Application\Truss.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.*" />
  </ItemGroup>

</Project>
