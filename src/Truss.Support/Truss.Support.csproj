<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Truss.Support</PackageId>
    <Description>The support surface of a Truss application: the wire contracts of the Truss Deck ingestion API and a typed client that carries the service credential, maps failures back to the local exceptions and makes retries safe with idempotency keys.</Description>
    <PackageTags>Support;Tickets;Deck;HelpDesk</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Truss.Application\Truss.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Truss.Support.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.*" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.*" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.*" />
  </ItemGroup>

</Project>
