<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Truss.Observability</PackageId>
    <Description>Observability for Truss: structured logging of every request, traces and metrics through the BCL ActivitySource and Meter, and ambient correlation ids. Everything opt-in.</Description>
    <PackageTags>Observability;Logging;OpenTelemetry;Correlation;Metrics</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Truss.Application\Truss.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.*" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.*" />
  </ItemGroup>

</Project>
