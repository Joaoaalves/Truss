<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Truss.Messaging</PackageId>
    <Description>Integration event runtime for Truss: versioned JSON serialization, transactional outbox with retry and dead-letter, transport abstraction, in-memory transport and consumer dispatch with a unit of work per message.</Description>
    <PackageTags>Messaging;Outbox;IntegrationEvents;CQRS;DDD</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Truss.Messaging.Abstractions\Truss.Messaging.Abstractions.csproj" />
    <ProjectReference Include="..\Truss.Application.Abstractions\Truss.Application.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Truss.Messaging.Tests" />
    <InternalsVisibleTo Include="Truss.Generators.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.*" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.*" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.*" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.*" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.*" />
  </ItemGroup>

</Project>
