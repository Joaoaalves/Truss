<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Truss.Email</PackageId>
    <Description>Email contracts for Truss: the message shape, the sender and address validation abstractions, and a console sender that prints messages during development.</Description>
    <PackageTags>Email;Sender;Abstractions</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.*" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.*" />
  </ItemGroup>

</Project>
