<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Truss.Email</PackageId>
    <Description>Email senders for Truss: SMTP through MailKit configured from options or environment variables, and a console sender that prints messages during development.</Description>
    <PackageTags>Email;Smtp;MailKit;Sender</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Truss.Email.Abstractions\Truss.Email.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DnsClient" Version="1.*" />
    <PackageReference Include="MailKit" Version="4.*" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.*" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.*" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.*" />
  </ItemGroup>

</Project>
